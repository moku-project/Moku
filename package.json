{
  "name": "moku",
  "private": true,
  "version": "0.9.4",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:static": "cross-env MOKU_TARGET=static vite build",
    "build:node": "MOKU_TARGET=node vite build",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "phosphor-svelte": "^3.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-http": "^2.8.1",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.4.1",
    "dashjs": "^5.2.1",
    "hls.js": "^1.7.3",
    "jassub": "^2.5.18",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "tauri-plugin-discord-rpc-api": "github:Youwes09/tauri-plugin-discord-rpc"
  }
}